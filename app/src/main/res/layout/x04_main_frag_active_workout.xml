<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Active workout title -->
    <TextView
        android:id="@+id/activeWorkoutTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Active Workout"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />


    <!-- Exercises being performed -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/activeWorkoutRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />


    <!-- Complete workout -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/finishWorkoutButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Finish Workout" />

</LinearLayout>