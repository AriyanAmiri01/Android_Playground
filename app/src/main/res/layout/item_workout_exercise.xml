<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Style_Card_Exercise"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/exerciseNameTextView"
            style="@style/Style_Text_Exercise_Name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bench Press" />

        <TextView
            android:id="@+id/muscleGroupTextView"
            style="@style/Style_Text_Exercise_Muscle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Chest" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/setsTextView"
                style="@style/Style_Text_Exercise_Start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sets: 3" />

            <TextView
                android:id="@+id/repetitionsTextView"
                style="@style/Style_Text_Exercise_Start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="Reps: 10" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>