<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"
    android:padding="20dp"

    android:background="@color/theme1_background">


    <!-- Exercise Name -->
    <TextView
        android:id="@+id/exerciseNameTextView"

        style="@style/Style_Text_Exercise_Detail_Title"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:text="Exercise"
        android:gravity="start" />

    <TextView
        android:id="@+id/muscleGroupTextView"

        style="@style/Style_Text_Exercise_Muscle"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="16dp"

        android:text="Muscle Group" />

    <!-- Video -->
    <com.google.android.material.card.MaterialCardView

        style="@style/Style_Card_Exercise_Video"

        android:layout_width="match_parent"
        android:layout_height="280dp"

        android:layout_marginTop="20dp">

        <VideoView
            android:id="@+id/exerciseVideoView"

            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </com.google.android.material.card.MaterialCardView>




</LinearLayout>