<?xml version="1.0" encoding="utf-8"?>

<resources xmlns:tools="http://schemas.android.com/tools">


    <!-- BASE THEME  -->
    <style name="Base.Theme.Android_Playground" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Colors -->
        <item name="android:colorBackground">@color/theme1_background</item>
        <item name="colorSurface">@color/theme1_surface</item>
        <item name="colorPrimary">@color/theme1_primary</item>
        <item name="colorSecondary">@color/theme1_secondary</item>
        <item name="strokeColor">@color/theme1_border</item>

        <!-- Default Button -->
        <item name="materialButtonStyle">@style/Style_Button_Primary</item>
    </style>




    <!-- Cards-->
    <style name="AppCard.Base" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="cardPreventCornerOverlap">true</item>
    </style>
    <style name="Style_Card_Workout" parent="Widget.MaterialComponents.CardView">
        <item name="cardUseCompatPadding">true</item>
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">0dp</item>
        <item name="cardPreventCornerOverlap">true</item>
        <item name="cardBackgroundColor">@color/theme1_surface</item>
        <item name="strokeColor">@color/theme1_border</item>
        <item name="strokeWidth">1dp</item>
    </style>


    <style name="Style_Card_Exercise" parent="@style/AppCard.Base">
        <item name="cardBackgroundColor">@color/theme1_surface</item>
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">0dp</item>
        <item name="strokeColor">@color/theme1_border</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="Style_Card_Workout_Exercise" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">0dp</item>
        <item name="cardBackgroundColor">@color/theme1_surface</item>
        <item name="strokeColor">@color/theme1_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">4dp</item>
        <item name="android:clipToOutline">true</item>
    </style>
    <!-- Exercise Video Card -->
    <style name="Style_Card_Exercise_Video" parent="@style/AppCard.Base">

        <item name="cardBackgroundColor">@color/theme1_surface</item>
        <item name="cardElevation">4dp</item>
        <item name="cardCornerRadius">0dp</item>
        <item name="strokeColor">@color/theme1_border</item>
        <item name="strokeWidth">1dp</item>

    </style>



    <style name="AppCard.Standard" parent="@style/AppCard.Base">
        <!-- Standard Card -->
        <item name="cardBackgroundColor">@color/theme1_text_primary</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">10dp</item>
        <item name="strokeColor">@color/theme1_border</item>
    </style>
    <style name="AppCard.Elevated" parent="@style/AppCard.Base">
        <!-- Elevated Card -->
        <item name="cardBackgroundColor">@color/theme1_background</item>
        <item name="cardElevation">6dp</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/theme1_border</item>
    </style>
    <style name="AppCard.Clickable" parent="@style/AppCard.Standard">
        <!-- Clickable Card -->
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="rippleColor">@color/theme1_border</item>
        <item name="cardElevation">3dp</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/theme1_border</item>
    </style>




    <!--Buttons -->
    <style name="AppButtonStyle.Base" parent="Widget.MaterialComponents.Button">
    </style>
    <style name="Style_Button_Primary" parent="Widget.MaterialComponents.Button">
        <!-- Secondary Button -->
        <item name="android:textColor">@color/theme1_secondary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">24dp</item>
    </style>
    <style name="Style_Button_Workout_Start" parent="@style/Style_Button_Primary">
        <item name="backgroundTint">@color/theme1_secondary</item>
        <item name="android:textColor">@color/theme1_text_secondary</item>
        <item name="strokeColor">@color/theme1_border</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">24dp</item>
    </style>
    <style name="Style_Button_Workout_Delete" parent="@style/Style_Button_Primary">
        <item name="backgroundTint">@color/theme1_danger</item>
        <item name="android:textColor">@color/theme1_text_primary</item>
        <item name="strokeColor">@color/theme1_text_primary</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">24dp</item>
    </style>


    <!--Navigation drawer-->
    <style name="AppNavigationDrawer" parent="Widget.MaterialComponents.NavigationView">

        <!-- Colors -->
        <item name="android:background">@color/theme1_background</item>
        <item name="itemTextColor">@color/theme1_text_secondary</item>
        <item name="itemIconTint">@color/theme1_border</item>

        <!-- Texts -->

        <item name="itemTextAppearance">@style/AppNavigationDrawer.Text</item>

        <!-- Layout -->
        <item name="itemIconPadding">20dp</item>
        <item name="itemHorizontalPadding">20dp</item>
    </style>
    <style name="AppNavigationDrawer.Text" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/theme1_text_secondary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="AppNavigationDrawer.ProfileImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>

    </style>



    <!-- TEXT STYLES -->
    <style name="Style_Text_Title">
        <item name="android:textColor">@color/theme1_text_primary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Style_Text_Body">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="Style_Text_Exercise_Name">
        <item name="android:textColor">@color/theme1_text_secondary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Style_Text_Exercise_Muscle">
        <item name="android:textColor">@color/theme1_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="Style_Text_Exercise_Start">
        <item name="android:textColor">@color/theme1_text_secondary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Style_Text_WorkoutExercise_Title">
        <item name="android:textColor">@color/theme1_text_primary</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Style_Text_WorkoutExercise_Body">
        <item name="android:textColor">@color/theme1_text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>


    <style name="Style_Text_Exercise_Detail_Title">
        <item name="android:textColor">@color/theme1_text_secondary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
    </style>
</resources>