<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">



    <!--==[MAIN FRAGMENTS]==-->
    <fragment
        android:id="@+id/nav_workout"
        android:name="com.example.android_playground.mainFrags.WorkoutFragment"
        android:label="Workout Library">
        <action
            android:id="@+id/action_workoutLibraryFragment_to_createWorkoutFragment"
            app:destination="@id/createWorkoutFragment" />
        <action
            android:id ="@+id/action_workoutLibraryFragment_to_workoutDetailsFragment"
            app:destination="@id/workoutDetailsFragment" />
    </fragment>
    <fragment
        android:id="@+id/nav_exercises"
        android:name="com.example.android_playground.mainFrags.ExercisesFragment"
        android:label="Exercises"
        android:layout="@layout/main_frag_exercises" />
    <fragment
        android:id="@+id/nav_history"
        android:name="com.example.android_playground.mainFrags.HistoryFragment"
        android:label="Workout Tracker"
        tools:layout="@layout/main_frag_history" />
    <fragment
        android:id="@+id/nav_timer"
        android:name="com.example.android_playground.mainFrags.TimerFragment"
        android:label="Timer"
        tools:layout="@layout/main_frag_timer" />
    <fragment
        android:id="@+id/nav_profile"
        android:name="com.example.android_playground.mainFrags.UserProfileFragment"
        android:label="User Profile"
        tools:layout="@layout/main_frag_user_profile" />



    <!--==[SUB FRAGMENTS]==-->
    <fragment
        android:id="@+id/createWorkoutFragment"
        android:name="com.example.android_playground.workoutLibrary.CreateWorkoutFragment"
        android:label="Create Workout">
    </fragment>
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.android_playground.authenticate.RegisterFragment"
        android:label="RegisterFragment">
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_registerFragment_to_nav_workout"
            app:destination="@id/nav_workout" />

    </fragment>
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.android_playground.authenticate.LoginFragment"
        android:label="LoginFragment">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_nav_workout"
            app:destination="@id/nav_workout" />
    </fragment>
    <fragment
        android:id="@+id/workoutDetailsFragment"
        android:name="com.example.android_playground.workoutLibrary.WorkoutDetailsFragment"
        android:label="Workout Details">
        <argument
            android:name="workoutId"
            app:argType="integer" />
        <action
            android:id="@+id/action_workoutDetailsFragment_to_exerciseFragment"
            app:destination="@id/exerciseFragment" />
    </fragment>
    <fragment
        android:id="@+id/exerciseFragment"
        android:name="com.example.android_playground.exercise.ExerciseFragment"
        android:label="Exercise">

        <argument
            android:name="exerciseId"
            app:argType="integer" />

    </fragment>



</navigation>